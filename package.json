{
  "name": "taxi-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/patch-html-lang.mjs && node scripts/validate-build.mjs",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "link:assets": "node scripts/link-assets.mjs",
    "build:districts": "node scripts/build-districts.mjs",
    "build:streets": "node scripts/build-street-index.mjs",
    "build:matrix": "node scripts/build-distance-matrix.mjs",
    "prebuild": "npm run build:districts && npm run build:streets && npm run build:matrix",
    "test:mobile": "playwright test"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "tar": "^7.5.22",
    "nanoid": "3.3.18",
    "brace-expansion": "1.1.18",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2"
  }
}
